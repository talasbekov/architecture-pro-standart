@startuml C4-Context-Deposits-MVP
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title C4 Context Diagram — Открытие депозитов (MVP)

Person(client, "Клиент", "Физическое лицо банка")
Person(bo, "Менеджер бэк-офиса", "Обрабатывает заявки на депозиты")

System_Ext(site, "Сайт банка", "Подача заявок новыми клиентами")
System_Ext(callcenter, "Система кол-центра", "Обработка заявок и звонки клиентам")
System_Ext(sms, "SMS-шлюз", "Отправка одноразовых кодов и уведомлений")

System_Boundary(bank, "Банк «Стандарт»") {

    System(ib, "Интернет-банк", "Веб-приложение для клиентов банка")
    System(depositMVP, "Backend депозитов (MVP)", "Обработка заявок на депозиты")
    System(ABS, "АБС", "Автоматизированная банковская система")

}

Rel(client, site, "Подаёт заявку на депозит")
Rel(site, callcenter, "Передаёт заявку")
Rel(callcenter, client, "Звонок, уточнение условий")
Rel(callcenter, depositMVP, "Создает заявку")

Rel(client, ib, "Подаёт заявку на депозит")
Rel(ib, depositMVP, "Отправляет заявку (HTTPS)")
Rel(depositMVP, ABS, "Асинхронная обработка заявки")

Rel(depositMVP, sms, "Отправка SMS")
Rel(sms, client, "SMS-уведомления")

Rel(bo, depositMVP, "Подтверждает условия депозита")
Rel(depositMVP, ABS, "Фиксация условий депозита")

@enduml
